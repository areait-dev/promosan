      "return_format": "array",
      "preview_size": "medium",
      "library": "all",
      "show_in_rest": 1
    },
    {
      "key": "field_news_visualizzazioni",
      "label": "Visualizzazioni",
      "name": "visualizzazioni",
      "type": "number",
      "instructions": "Contatore visualizzazioni (single news).",
      "default_value": 0
    },
    {
      "key": "field_news_autore",
      "label": "Autore",
      "name": "autore",
      "type": "group",
      "layout": "block",
      "sub_fields": [
        {
          "key": "field_news_autore_nome",
          "label": "Nome",
          "name": "nome",
          "type": "text"
        },
        {
          "key": "field_news_autore_ruolo",
          "label": "Ruolo",
          "name": "ruolo",
          "type": "text"
        },
        {
          "key": "field_news_autore_iniziali",
          "label": "Iniziali",
          "name": "iniziali",
          "type": "text",
          "maxlength": 3
        }
      ]
    }
  ],
  "location": [
    [
      {
        "param": "post_type",
        "operator": "==",
        "value": "news"
      }
    ]
  ],
  "menu_order": 0,
  "position": "normal",
  "style": "default",
  "active": true,
  "show_in_rest": 1,
